{
  "name": "shadowcoach",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run assets && npm run dev -w apps/web",
    "assets": "node scripts/assets.mjs",
    "model:download": "node scripts/download-model.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:parity": "node --import tsx scripts/parity.ts",
    "build": "npm run assets && npm run typecheck && npm run build -w apps/web && node scripts/audit-build.mjs",
    "preview": "npm run preview -w apps/web",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
